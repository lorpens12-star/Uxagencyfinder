---
import Icon from './Icon.astro';
import { getIndustries } from '../lib/data';
import { themeFor } from '../lib/visuals';
const industries = getIndustries();
const path = Astro.url.pathname;
const isActive = (p: string) => path.startsWith(p);
---

<header class="site-header" id="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label="UX Agency Finders home">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true"><defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#4f46e5"/><stop offset="1" stop-color="#7c3aed"/></linearGradient></defs><rect width="32" height="32" rx="9" fill="url(#lg)"/><circle cx="14.5" cy="14.5" r="6" fill="none" stroke="#fff" stroke-width="2.6"/><path d="M19.2 19.2l4.6 4.6" stroke="#fff" stroke-width="2.8" stroke-linecap="round"/></svg>
      <span>UX Agency <b>Finders</b></span>
    </a>

    <nav aria-label="Main" class="main-nav">
      <ul>
        <li>
          <details class="niche-menu">
            <summary class:list={[{ active: isActive('/agencies/') }]}>Browse niches <Icon name="chevron" size={16} /></summary>
            <div class="menu-panel">
              <p class="menu-title">Agencies by industry</p>
              <ul>
                {industries.map((i) => {
                  const t = themeFor(i.id);
                  return (
                    <li>
                      <a href={i.route}>
                        <span class="mi" style={`color:${t.color};background:${t.soft}`}><Icon name={i.id} size={18} /></span>
                        <span><strong>{i.name}</strong><small>{i.placements.length} agencies</small></span>
                      </a>
                    </li>
                  );
                })}
              </ul>
              <a class="menu-all" href="/agencies/">View all industries <Icon name="arrow" size={16} /></a>
            </div>
          </details>
        </li>
        <li><a href="/directory/" class:list={[{ active: isActive('/directory/') }]}>Agency directory</a></li>
        <li><a href="/guides/" class:list={[{ active: isActive('/guides/') }]}>Hiring guides</a></li>
        <li><a href="/methodology/" class:list={[{ active: isActive('/methodology/') }]}>How we select</a></li>
      </ul>
    </nav>

    <a class="btn btn-dark btn-small header-cta" href="/agencies/">Find agencies</a>

    <details class="mobile-toggle">
      <summary aria-label="Open menu"><Icon name="menu" size={22} /></summary>
      <nav aria-label="Mobile" class="mobile-nav">
        <p class="menu-title">Browse niches</p>
        <ul class="mobile-grid">
          {industries.map((i) => {
            const t = themeFor(i.id);
            return <li><a href={i.route}><span class="mi" style={`color:${t.color};background:${t.soft}`}><Icon name={i.id} size={16} /></span>{i.name}</a></li>;
          })}
        </ul>
        <ul class="mobile-main">
          <li><a href="/agencies/">All industries</a></li>
          <li><a href="/directory/">Agency directory</a></li>
          <li><a href="/guides/">Hiring guides</a></li>
          <li><a href="/methodology/">How we select</a></li>
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  const menus = document.querySelectorAll<HTMLDetailsElement>('.niche-menu, .mobile-toggle');
  document.addEventListener('click', (e) => {
    menus.forEach((m) => { if (m.open && !m.contains(e.target as Node)) m.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    menus.forEach((m) => { if (m.open) { m.open = false; m.querySelector('summary')?.focus(); } });
  });
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgb(255 255 255 / 0.8); backdrop-filter: saturate(180%) blur(14px); -webkit-backdrop-filter: saturate(180%) blur(14px); border-bottom: 1px solid transparent; transition: border-color 0.2s, box-shadow 0.2s; }
  .site-header.scrolled { border-bottom-color: var(--c-border); box-shadow: 0 4px 20px -12px rgb(15 23 42 / 0.15); }
  .bar { display: flex; align-items: center; gap: 1.5rem; min-height: 4.25rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; color: var(--c-text); text-decoration: none; font-weight: 600; font-size: 1.05rem; letter-spacing: -0.02em; margin-right: auto; }
  .brand b { font-weight: 800; }
  .main-nav > ul { display: flex; align-items: center; gap: 0.15rem; list-style: none; margin: 0; padding: 0; }
  .main-nav a, .main-nav summary { display: inline-flex; align-items: center; gap: 0.25rem; padding: 0.5rem 0.8rem; border-radius: 999px; color: var(--c-text-2); text-decoration: none; font-weight: 500; font-size: 0.92rem; cursor: pointer; transition: background 0.15s, color 0.15s; }
  .main-nav a:hover, .main-nav summary:hover, .niche-menu[open] summary { background: var(--c-surface-2); color: var(--c-text); }
  .main-nav .active { color: var(--c-accent); }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .niche-menu { position: relative; }
  .niche-menu summary :global(svg) { transition: transform 0.2s; }
  .niche-menu[open] summary :global(svg) { transform: rotate(180deg); }
  .menu-panel { position: absolute; left: 50%; transform: translateX(-50%); top: calc(100% + 0.6rem); width: 520px; background: var(--c-surface); border: 1px solid var(--c-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); padding: 0.85rem; animation: pop 0.18s var(--ease); }
  @keyframes pop { from { opacity: 0; transform: translate(-50%, -6px); } to { opacity: 1; transform: translate(-50%, 0); } }
  .menu-title { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--c-muted); margin: 0.25rem 0.5rem 0.5rem; }
  .menu-panel ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0.15rem; }
  .menu-panel li a { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem; border-radius: 12px; }
  .menu-panel li a:hover { background: var(--c-bg-soft); }
  .menu-panel li a span:last-child { display: flex; flex-direction: column; line-height: 1.3; }
  .menu-panel strong { font-size: 0.92rem; }
  .menu-panel small { font-size: 0.78rem; color: var(--c-muted); }
  .mi { display: inline-grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 10px; flex: none; }
  .menu-all { display: flex !important; justify-content: space-between; margin-top: 0.5rem; padding: 0.75rem 0.85rem !important; border-radius: 12px !important; background: var(--c-bg-soft); color: var(--c-accent) !important; font-weight: 600 !important; }

  .mobile-toggle { display: none; }
  @media (max-width: 960px) {
    .main-nav, .header-cta { display: none; }
    .mobile-toggle { display: block; }
    .mobile-toggle summary { display: grid; place-items: center; width: 2.6rem; height: 2.6rem; border: 1px solid var(--c-border); border-radius: 12px; cursor: pointer; color: var(--c-text); }
    .mobile-nav { position: absolute; left: 0; right: 0; top: 100%; background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding: 1rem 1.25rem 1.5rem; box-shadow: var(--shadow-lg); max-height: calc(100vh - 4.25rem); overflow-y: auto; }
    .mobile-nav ul { list-style: none; margin: 0; padding: 0; }
    .mobile-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.25rem; }
    .mobile-grid a { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem; border-radius: 10px; color: var(--c-text); text-decoration: none; font-weight: 500; font-size: 0.95rem; }
    .mobile-grid .mi { width: 1.9rem; height: 1.9rem; border-radius: 8px; }
    .mobile-main { border-top: 1px solid var(--c-border); margin-top: 0.85rem !important; padding-top: 0.6rem !important; }
    .mobile-main a { display: block; padding: 0.65rem 0.5rem; color: var(--c-text); text-decoration: none; font-weight: 600; }
  }
</style>
