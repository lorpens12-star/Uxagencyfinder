---
import { getIndustries, site } from '../lib/data';
const industries = getIndustries();
const year = new Date(site.lastReviewed).getUTCFullYear();
---

<footer class="site-footer">
  <div class="container cta-band">
    <div>
      <h2>Find a UX partner who knows your market.</h2>
      <p>Compare agencies by real industry work, not by marketing claims.</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary" href="/agencies/">Browse by industry</a>
      <a class="btn btn-outline" href="/guides/ux-agency-brief-template/">Get the brief template</a>
    </div>
  </div>
  <div class="container cols">
    <div class="about">
      <a class="brand" href="/">
        <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="9" fill="#4f46e5"/><circle cx="14.5" cy="14.5" r="6" fill="none" stroke="#fff" stroke-width="2.6"/><path d="M19.2 19.2l4.6 4.6" stroke="#fff" stroke-width="2.8" stroke-linecap="round"/></svg>
        UX Agency Finders
      </a>
      <p>A curated guide to the best UX design agencies for each industry, built on named projects and cited sources.</p>
    </div>
    <nav aria-label="Industries">
      <p class="heading">Industries</p>
      <ul>{industries.map((i) => <li><a href={i.route}>{i.name}</a></li>)}</ul>
    </nav>
    <nav aria-label="Resources">
      <p class="heading">Resources</p>
      <ul>
        <li><a href="/directory/">Agency directory</a></li>
        <li><a href="/guides/">Hiring guides</a></li>
        <li><a href="/guides/ux-agency-brief-template/">Brief template</a></li>
        <li><a href="/methodology/">How we select</a></li>
      </ul>
    </nav>
    <nav aria-label="Company">
      <p class="heading">Company</p>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/editorial-policy/">Editorial policy</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/terms/">Terms</a></li>
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <span>© {year} UX Agency Finders. All rights reserved.</span>
    <span>Agency names and trademarks belong to their respective owners.</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--c-dark); color: #94a3b8; padding-block: 0 2rem; margin-top: 0; }
  .cta-band { display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap; padding-block: 3.5rem; border-bottom: 1px solid rgb(255 255 255 / 0.08); }
  .cta-band h2 { color: #fff; font-size: clamp(1.5rem, 3vw, 2.1rem); margin: 0 0 0.4rem; }
  .cta-band p { margin: 0; color: #94a3b8; font-size: 1.05rem; }
  .cta-actions { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .btn-outline { color: #fff; border-color: rgb(255 255 255 / 0.25); }
  .btn-outline:hover { color: #fff; border-color: #fff; background: rgb(255 255 255 / 0.06); }
  .cols { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2.5rem; padding-block: 3rem 2.5rem; }
  .brand { display: inline-flex; align-items: center; gap: 0.6rem; color: #fff; font-weight: 700; text-decoration: none; font-size: 1.05rem; margin-bottom: 0.85rem; }
  .about p { font-size: 0.92rem; max-width: 340px; line-height: 1.6; }
  .heading { font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; color: #fff; margin-bottom: 0.9rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin-bottom: 0.55rem; }
  li a { color: #94a3b8; text-decoration: none; font-size: 0.92rem; }
  li a:hover { color: #fff; }
  .legal { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem 2rem; border-top: 1px solid rgb(255 255 255 / 0.08); padding-top: 1.5rem; font-size: 0.84rem; color: #94a3b8; }
  @media (max-width: 800px) { .cols { grid-template-columns: 1fr 1fr; } .about { grid-column: 1 / -1; } }
</style>
