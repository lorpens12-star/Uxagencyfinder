---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { site, absolute } from '../lib/data';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>[];
  fullTitle?: string;
  ogType?: 'website' | 'article' | 'profile';
}

const { title, description, jsonLd = [], fullTitle, ogType = 'website' } = Astro.props;
const pageTitle = fullTitle ?? `${title} | ${site.name}`;
const canonical = absolute(Astro.url.pathname);
const ogImage = absolute('/og-image.png');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={site.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="UX Agency Finders: find the best UX agencies for your industry" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" title="LLM summary" href="/llms.txt" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {jsonLd.map((obj) => <JsonLd data={obj} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Subtle reveal-on-scroll. Content is fully visible without JS. Anything at or above the fold
      // (including content skipped past by fast scrolling or anchor jumps) is revealed.
      let pending = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        pending.forEach((el) => el.classList.add('in'));
        pending = [];
      }
      let ticking = false;
      const update = () => {
        ticking = false;
        const limit = window.innerHeight * 0.94;
        // Read all positions first, then write classes (avoids layout thrashing).
        const tops = pending.map((el) => el.getBoundingClientRect().top);
        const show = pending.filter((_, i) => tops[i] < limit);
        pending = pending.filter((_, i) => tops[i] >= limit);
        show.forEach((el) => el.classList.add('in'));
        if (!pending.length) { window.removeEventListener('scroll', onScroll); window.removeEventListener('resize', onScroll); }
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      update();
    </script>
  </body>
</html>

<style>
  main:focus { outline: none; }
</style>
