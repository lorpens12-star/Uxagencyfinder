---
// Layout for Markdown pages (guides and policy pages in src/pages/**/*.md).
// Frontmatter: title, description, type ("guide" | omit), worksheet (boolean), icon (optional icon name)
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import AuthorReviewLine from '../components/AuthorReviewLine.astro';
import Icon from '../components/Icon.astro';
import { site, absolute, guides } from '../lib/data';

const { frontmatter } = Astro.props;
const path = Astro.url.pathname;
const isGuide = frontmatter.type === 'guide';
const crumbs = isGuide
  ? [{ name: 'Hiring guides', href: '/guides/' }, { name: frontmatter.title, href: path }]
  : [{ name: frontmatter.title, href: path }];

const jsonLd = isGuide
  ? [{
      '@type': 'Article',
      headline: frontmatter.title,
      description: frontmatter.description,
      url: absolute(path),
      dateModified: site.lastReviewed,
      author: { '@type': 'Organization', name: site.publisher.name, url: site.siteUrl },
      publisher: { '@type': 'Organization', name: site.publisher.name, url: site.siteUrl },
    }]
  : [{ '@type': 'WebPage', name: frontmatter.title, url: absolute(path) }];
const otherGuides = guides.filter((g) => `/guides/${g.slug}/` !== path);
---

<BaseLayout title={frontmatter.title} description={frontmatter.description} jsonLd={jsonLd} ogType={isGuide ? 'article' : 'website'}>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">{isGuide ? 'Hiring guide' : frontmatter.eyebrow ?? 'UX Agency Finders'}</p>
      <h1>{frontmatter.title}</h1>
      {frontmatter.description && <p class="lead">{frontmatter.description}</p>}
      {isGuide && <AuthorReviewLine />}
      {isGuide && frontmatter.worksheet && (
        <p class="no-print tools"><button type="button" class="btn btn-secondary btn-small" onclick="window.print()"><Icon name="file" size={16} />Print this guide</button></p>
      )}
    </div>
  </header>
  <div class="container section layout">
    <article class="prose">
      <slot />
    </article>
    <aside class="no-print side">
      {isGuide ? (
        <div class="side-card">
          <p class="side-title">More guides</p>
          <ul>{otherGuides.map((g) => <li><a href={`/guides/${g.slug}/`}>{g.title}</a></li>)}</ul>
          <a class="btn btn-primary btn-small" href="/agencies/">Browse agencies <Icon name="arrow" size={14} /></a>
        </div>
      ) : (
        <div class="side-card">
          <p class="side-title">Quick links</p>
          <ul>
            <li><a href="/methodology/">How we select</a></li>
            <li><a href="/editorial-policy/">Editorial policy</a></li>
            <li><a href="/about/">About</a></li>
            <li><a href="/contact/">Contact</a></li>
          </ul>
        </div>
      )}
    </aside>
  </div>
</BaseLayout>

<script>
  // Add "Copy" buttons to worksheet code blocks (progressive enhancement).
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const wrap = document.createElement('div');
    wrap.className = 'worksheet';
    pre.parentNode!.insertBefore(wrap, pre);
    wrap.appendChild(pre);
    if (!navigator.clipboard) return;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'btn btn-secondary btn-small copy-btn no-print';
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText);
        btn.textContent = 'Copied ✓';
      } catch {
        btn.textContent = 'Select the text to copy';
      }
      setTimeout(() => (btn.textContent = 'Copy'), 2000);
    });
    wrap.appendChild(btn);
  });
</script>

<style>
  .tools { margin-top: 1.25rem; }
  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 4rem; }
  .side { position: sticky; top: 6rem; align-self: start; }
  .side-card { background: var(--c-bg-soft); border: 1px solid var(--c-border); border-radius: var(--radius-lg); padding: 1.35rem; }
  .side-title { font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: var(--c-muted); }
  .side ul { list-style: none; padding: 0; margin: 0 0 1.25rem; display: grid; gap: 0.6rem; }
  .side li a { font-size: 0.93rem; font-weight: 500; color: var(--c-text-2); text-decoration: none; }
  .side li a:hover { color: var(--c-accent); }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; gap: 2rem; } .side { position: static; } }
</style>
